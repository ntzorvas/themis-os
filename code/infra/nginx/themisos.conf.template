# nginx site config template — ΘΕΜΙΣ OS
# Αντικαταστήστε ${PRODUCT_DOMAIN} με το πραγματικό domain
# Αναφορά: docs/v03/tech-stack-v03.md §10

# Upstream: Next.js (frontend)
upstream themisos_web {
    server 127.0.0.1:3110;
    keepalive 32;
}

# Upstream: Fastify (API)
upstream themisos_api {
    server 127.0.0.1:4000;
    keepalive 64;
}

# HTTP → HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name ${PRODUCT_DOMAIN} *.${PRODUCT_DOMAIN};
    return 301 https://$host$request_uri;
}

# Main HTTPS server — apex + wildcard subdomains (tenant routing)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${PRODUCT_DOMAIN} *.${PRODUCT_DOMAIN};

    # TLS — Let's Encrypt (διαχείριση μέσω Cloudflare)
    ssl_certificate     /etc/letsencrypt/live/${PRODUCT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PRODUCT_DOMAIN}/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:MozSSL:10m;
    ssl_session_tickets off;

    # TLS hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # HSTS
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # API routes → Fastify
    location /api/ {
        proxy_pass http://themisos_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;

        # Rate limiting — Nginx level (application-level rate limit στο Fastify)
        limit_req zone=api_limit burst=20 nodelay;
    }

    # Health check — direct to API (δεν περνά από Next.js)
    location /health {
        proxy_pass http://themisos_api;
        proxy_set_header Host $host;
        access_log off;
    }

    # Next.js static assets — cache aggressively (immutable hashed filenames)
    location /_next/static/ {
        proxy_pass http://themisos_web;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        proxy_set_header Host $host;
    }

    # All other requests → Next.js
    location / {
        proxy_pass http://themisos_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Firm-Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }

    # Αρχεία log
    access_log /var/log/nginx/themisos_access.log;
    error_log  /var/log/nginx/themisos_error.log warn;
}

# Rate limit zone (στο nginx.conf http block, εδώ για αναφορά)
