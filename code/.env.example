# ============================================================
# ΘΕΜΙΣ OS — Environment Variables Template
# Αντιγράψτε σε .env.local και συμπληρώστε τις τιμές.
# ΠΟΤΕ μη δεσμεύσετε το .env.local στο git.
# ============================================================

# Ταυτότητα προϊόντος
PRODUCT_NAME="ΘΕΜΙΣ OS"
PRODUCT_SLUG="themisos"
PRODUCT_DOMAIN="themisos.gr"

# Περιβάλλον
NODE_ENV="development"
LOG_LEVEL="info"

# ============================================================
# DATABASE (PostgreSQL 16)
# ============================================================
DATABASE_URL="postgres://app_user:password@localhost:5432/themisos_dev"
# Για schema-per-tenant: το prefix schema είναι firm_<uuid_short>
DB_POOL_MAX="20"

# ============================================================
# VECTOR DATABASE (Qdrant — PC Compute Node)
# ============================================================
QDRANT_HOST="10.0.0.10"
QDRANT_PORT="6333"
QDRANT_API_KEY=""
# Collection για νομικό corpus (υπάρχουσα)
QDRANT_LEGAL_COLLECTION="themisos_legal_corpus"

# ============================================================
# STORAGE (Cloudflare R2 — EU jurisdiction)
# ============================================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="themisos-documents"
R2_REGION="eu"
# Προθήκη για έγγραφα γραφείου: firms/<firm_id>/documents/
R2_BUCKET_BACKUPS="themisos-backups"

# ============================================================
# CACHE + QUEUE (Redis 7 + BullMQ)
# ============================================================
REDIS_URL="redis://localhost:6379"
# TTL cache για firm metadata (seconds)
REDIS_FIRM_CACHE_TTL="300"

# ============================================================
# AUTH (NextAuth.js v5)
# ============================================================
NEXTAUTH_URL="https://themisos.gr"
NEXTAUTH_SECRET=""
# JWT access token lifetime (seconds)
JWT_ACCESS_TTL="3600"
# Refresh token lifetime (days)
JWT_REFRESH_TTL_DAYS="14"

# ============================================================
# AI — Anthropic (Claude)
# ============================================================
ANTHROPIC_API_KEY=""
# Sonnet 4.6 για Συγγράμματος + Ερευνητικός
CLAUDE_MODEL_PRIMARY="claude-sonnet-4-6-20260201"
# Haiku 4.5 για Προθεσμίας + Αναγνώστης
CLAUDE_MODEL_FAST="claude-haiku-4-5-20260201"

# ============================================================
# AI OBSERVABILITY (Langfuse — self-hosted Bridge :3600)
# ============================================================
LANGFUSE_BASE_URL="http://localhost:3600"
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# ============================================================
# PAYMENTS
# ============================================================

# Viva Wallet (κύρια πύλη — Ελληνική αγορά)
VIVA_MERCHANT_ID=""
VIVA_API_KEY=""
VIVA_SOURCE_CODE=""
VIVA_ENV="demo"
# demo | production

# Εθνική Τράπεζα (εναλλακτική)
ETHNIKI_MERCHANT_ID=""
ETHNIKI_API_KEY=""
ETHNIKI_ENV="sandbox"
# sandbox | production

# ============================================================
# ΑΑΔΕ myDATA
# ============================================================
AADE_USER_ID=""
AADE_SUBSCRIPTION_KEY=""
AADE_ENV="dev"
# dev | prod
AADE_API_URL_DEV="https://mydata-dev.azure-api.net"
AADE_API_URL_PROD="https://mydata.azure-api.net"

# ============================================================
# EMAIL (Resend.com)
# ============================================================
RESEND_API_KEY=""
EMAIL_FROM="noreply@themisos.gr"
EMAIL_REPLY_TO="support@themisos.gr"

# ============================================================
# KMS (HashiCorp Vault — self-hosted, dedicated CX22 Helsinki)
# Απαιτείται για envelope encryption + per-tenant DEK management
# Αναφορά: docs/v03/tech-stack-v03.md §17.1, docs/day5-vault-runbook.md
# ============================================================

# Vault server address.
# Dev: http://127.0.0.1:8200  (vault server -dev, root token)
# Prod: http://vault.themisos.gr:8200  (Hetzner CX22, WireGuard-only access)
VAULT_ADDR=http://127.0.0.1:8200

# Authentication token.
# Dev: root token printed by `vault server -dev` at startup.
# Prod: AppRole secret-id obtained via `vault write auth/approle/login ...`
#       See docs/day5-vault-runbook.md §4 (AppRole setup) for production flow.
VAULT_TOKEN=

# Vault namespace for multi-tenancy within a single Vault cluster.
# Keep as 'themisos' unless renaming the product (rename-friendly via env).
VAULT_NAMESPACE=themisos

# KV-v2 secrets engine mount path.
# Default: 'kv' (matches `vault secrets enable -path=kv kv-v2` in runbook).
# All per-firm DEKs are stored under: <VAULT_KV_MOUNT>/firms/<slug>/dek|pek
VAULT_KV_MOUNT=kv

# ============================================================
# ERROR TRACKING (Sentry)
# ============================================================
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
# development | staging | production

# ============================================================
# OBSERVABILITY (Grafana/Prometheus — self-hosted Bridge :3003)
# ============================================================
PROMETHEUS_METRICS_PORT="9090"

# ============================================================
# SERVER PORTS
# ============================================================
# Next.js frontend
WEB_PORT="3110"
# Fastify API
API_PORT="4000"
