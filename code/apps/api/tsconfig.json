  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "paths": {
      "@themisos/db": ["../../packages/db/src/index.ts"],
      "@themisos/types": ["../../packages/types/src/index.ts"],
      "@themisos/greek-utils": ["../../packages/greek-utils/src/index.ts"],
      "@themisos/crypto": ["../../packages/crypto/src/index.ts"],
